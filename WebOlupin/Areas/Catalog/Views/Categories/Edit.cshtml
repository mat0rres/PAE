@model MOROPO.PremierAutomotiveExport.WebOlupin.Models.View.Backend.CategoryInputViewModel

@{
    const string TITLE = "Modificar Categoría";
    const string HEADER = "Administración de Categorías";

    ViewData["TITLE"] = TITLE;
    ViewData["HEADER"] = HEADER;

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<i class=\"fas fa-fw fa-tachometer-alt\"></i> " + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = Url.Action("Index", "Dashboard", new { Area = "management" })
        },
        new BreadcrumbViewModel
        {
            Caption = HEADER,
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = TITLE
        }
    };

    Layout = "_BackendLayout";
}

<hr class="mt-0 mb-4" />

@using (Html.BeginForm("edit", "categories", new { Area = "catalog", key = string.Empty }, FormMethod.Post, true, null))
{
    @Html.ValidationSummary(true)

    @Html.HiddenFor(model => model.Id)

    <div class="card mb-4">
        <div class="card-header"><h5 class="mb-0 font-weight-bold text-primary">@TITLE</h5></div>

        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.Name, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Name, null, new { @class = "text-danger" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(model => model.ParentId, new { @class = "control-label" })
                    @Html.DropDownListFor(model => model.ParentId, Model.AvailableCategorySelectListItems, "--Ninguna--", new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.ParentId, null, new { @class = "text-danger" })
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6 mb-3">
                    <div class="checkbox">
                        <label>
                            @Html.EditorFor(model => model.Enabled) Habilitada?
                            @Html.ValidationMessageFor(model => model.Enabled)
                        </label>
                    </div>
                </div>
                <div class="col-sm-6 mb-3">
                    <div class="checkbox">
                        <label>
                            @Html.EditorFor(model => model.IsOnNavigation) Mostrar en Navegación?
                            @Html.ValidationMessageFor(model => model.IsOnNavigation)
                        </label>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Modificar</button>
            <a class="btn btn-secondary" href="@Url.Action("index")">Regresar al listado</a>
        </div>
    </div>
}