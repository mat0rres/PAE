@model MOROPO.PremierAutomotiveExport.WebOlupin.Models.View.Backend.CustomAttributeInputViewModel

@{
    const string TITLE = "Modify Custom Attribute";
    const string HEADER = "Custom Attribute Management";

    ViewData["TITLE"] = TITLE;
    ViewData["HEADER"] = HEADER;

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<i class=\"fas fa-fw fa-tachometer-alt\"></i> " + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = Url.Action("Index", "Dashboard", new { Area = "management" })
        },
        new BreadcrumbViewModel
        {
            Caption = HEADER,
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = TITLE
        }
    };

    Layout = "_BackendLayout";

    var prioritySelectListItems = new List<SelectListItem>();

    for (int i = 1; i <= 10; i++)
    {
        prioritySelectListItems.Add(new SelectListItem { Text = i.ToString(), Value = i.ToString() });
    }
}

<hr class="mt-0 mb-4" />

@using (Html.BeginForm("edit", "customattributes", new { Area = "catalog", key = string.Empty }, FormMethod.Post, true, null))
{
    @Html.ValidationSummary(true)

    @Html.HiddenFor(model => model.Id)

    <div class="card mb-4">
        <div class="card-header"><h5 class="mb-0 font-weight-bold text-primary">@TITLE</h5></div>

        <div class="card-body">
            <div class="mb-3">
                @Html.LabelFor(model => model.Name, new { @class = "control-label" })
                @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Name, null, new { @class = "text-danger" })
            </div>
            <div class="row">
                <div class="col-sm-6 mb-3">
                    @Html.LabelFor(model => model.Priority, new { @class = "control-label" })
                    @Html.DropDownListFor(model => model.Priority, prioritySelectListItems, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Priority, null, new { @class = "text-danger" })
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Modify</button>
            <a class="btn btn-secondary" href="@Url.Action("index")">Back to list</a>
        </div>
    </div>
}