@model MOROPO.PremierAutomotiveExport.WebOlupin.Models.View.Backend.ServiceInputViewModel

@{
    const string TITLE = "Add Service";
    const string HEADER = "Service Management";

    ViewData["TITLE"] = TITLE;
    ViewData["HEADER"] = HEADER;

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<i class=\"fas fa-fw fa-tachometer-alt\"></i> " + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = Url.Action("Index", "Dashboard", new { Area = "management" })
        },
        new BreadcrumbViewModel
        {
            Caption = HEADER,
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = TITLE
        }
    };

    Layout = "_BackendLayout";

    var prioritySelectListItems = new List<SelectListItem>();

    for (int i = 1; i <= 10; i++)
    {
        prioritySelectListItems.Add(new SelectListItem { Text = i.ToString(), Value = i.ToString() });
    }
}

@section styles {
    <style type="text/css">
        #FeatureImageFile {
            width: 0;
            height: 0;
            overflow: hidden;
        }
    </style>
}

@section scripts {
    <script type="text/javascript" src="/vendor/ckeditor/ckeditor.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            ClassicEditor
                .create(document.querySelector('#Description'))
                .then(editor => {
                    editor.editing.view.change(writer => {
                        writer.setStyle('height', '480px', editor.editing.view.document.getRoot());
                    });
                })
                .catch(error => {
                    console.error(error);
                });
        });

        $(function () {
            $(document).on("change", "#FeatureImageFile", function () {
                var files = !!this.files ? this.files : [];

                if (!files.length || !window.FileReader) return; // no file selected, or no FileReader support

                if (/^image/.test(files[0].type)) {
                    var reader = new FileReader();

                    reader.readAsDataURL(files[0]);

                    reader.onloadend = function () {
                        $('#ImageFilePreview').attr('src', this.result);
                    }
                }

            });
        });
    </script>
}

<hr class="mt-0 mb-4" />

@using (Html.BeginForm("create", "services", new { Area = "catalog" }, FormMethod.Post, true, new { enctype = "multipart/form-data" }))
{
    @Html.ValidationSummary(true)

    <div class="card mb-4">
        <div class="card-header"><h5 class="mb-0 font-weight-bold text-primary">@TITLE</h5></div>

        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <div class="card">
                        <img src="~/img/default-organization-picture.png" class="card-img-top" id="ImageFilePreview" />
                        <label class="btn btn-light" style="border-top-left-radius: 0; border-top-right-radius: 0; margin-bottom: 0;">
                            @GlobalViewLocalizationHelper.Localize("Upload", ViewLocalizer) ...
                            @Html.EditorFor(model => model.FeatureImageFile)
                        </label>
                    </div>
                    @Html.ValidationMessageFor(model => model.FeatureImageFile, null, new { @class = "text-danger" })
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        @Html.LabelFor(model => model.Name, new { @class = "control-label" })
                        @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.Name, null, new { @class = "text-danger" })
                    </div>
                    <div class="row">
                        <div class="col-sm-6 mb-3">
                            <div class="checkbox">
                                <label>
                                    @Html.EditorFor(model => model.Enabled) Enabled?
                                    @Html.ValidationMessageFor(model => model.Enabled)
                                </label>
                            </div>
                        </div>
                        <div class="col-sm-6 mb-3">
                            @Html.LabelFor(model => model.Priority, new { @class = "control-label" })
                            @Html.DropDownListFor(model => model.Priority, prioritySelectListItems, new { @class = "form-control" })
                            @Html.ValidationMessageFor(model => model.Priority, null, new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="mb-3">
                        @Html.LabelFor(model => model.Description, new { @class = "control-label" })
                        @Html.TextAreaFor(model => model.Description, 16, 0, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.Description, null, new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Add</button>
            <a class="btn btn-secondary" href="@Url.Action("index")">Cancel</a>
        </div>
    </div>
}