@using MOROPO.PremierAutomotiveExport.WebOlupin.Extensions;

@model MOROPO.Framework.Guama.Core.Presentation.Web.Frontend.Models.View.PaginationViewModel<MOROPO.PremierAutomotiveExport.Persistence.Domain.Entities.CommonContactRecord, long, MOROPO.PremierAutomotiveExport.WebOlupin.Models.View.Backend.CommonContactRecordDisplayViewModel>

@{
    const string HEADER = "Common Contact Record Management";

    ViewData["TITLE"] = ViewData["HEADER"] = HEADER;

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<i class=\"fas fa-fw fa-tachometer-alt\"></i> " + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = Url.Action("Index", "Dashboard", new { Area = "management" })
        },
        new BreadcrumbViewModel
        {
            Caption = HEADER
        }
    };

    Layout = "_BackendLayout";
}

<hr class="mt-0 mb-4" />

<div class="card">
    <div class="card-header">
        <h5 class="m-0 font-weight-bold text-primary">Common contact record list</h5>
    </div>
    <div class="card-body">
        @if (Model.HasNext || Model.HasPrevious)
        {
            var paginationStart = (Model.Page - 1) * Model.Limit + 1;
            var paginationEnd = paginationStart - 1 + Model.List.Count;

            <div class="row">
                <div class="col mb-2">
                    <span style="font-weight: 600;">Showing page @Model.Page</span>: del @paginationStart al @paginationEnd, <span style="font-weight: 600;">Total pages</span>: @Model.MaxPageCount
                </div>
                <div class="col-auto mb-2">
                    <ul class="pagination">
                        @if (Model.HasPrevious)
                        {
                            <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", Model.Page - 1}})">&laquo;</a></li>
                        }
                        else
                        {
                            <li class="disabled page-item"><a class="page-link" href="#">&laquo;</a></li>
                        }

                        @if (Model.MaxPageCount > 5)
                        {
                            if (Model.Page > 3)
                            {
                                if (Model.MaxPageCount - Model.Page < 3)
                                {
                                    for (var i = Model.MaxPageCount - 4; i <= Model.MaxPageCount; i++)
                                    {
                                        if (i == Model.Page)
                                        {
                                            <li class="active page-item"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                                        }
                                        else
                                        {
                                            <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                        }
                                    }
                                }
                                else
                                {
                                    for (var i = Model.Page - 2; i <= Model.Page + 2; i++)
                                    {
                                        if (i == Model.Page)
                                        {
                                            <li class="active page-item"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                                        }
                                        else
                                        {
                                            <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                        }
                                    }
                                }
                            }
                            else
                            {
                                for (var i = 1; i <= 5; i++)
                                {
                                    if (i == Model.Page)
                                    {
                                        <li class="active page-item"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                                    }
                                    else
                                    {
                                        <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                    }
                                }
                            }
                        }
                        else
                        {
                            for (var i = 1; i <= Model.MaxPageCount; i++)
                            {
                                if (i == Model.Page)
                                {
                                    <li class="active page-item"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                                }
                                else
                                {
                                    <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                }
                            }
                        }

                        @if (Model.HasNext)
                        {
                            <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", Model.Page + 1}})">&raquo;</a></li>
                        }
                        else
                        {
                            <li class="disabled page-item"><a class="page-link" href="#">&raquo;</a></li>
                        }
                    </ul>
                </div>
            </div>
        }
    
        <div style="border: 1px solid #DDD; border-radius: 4px;">
            <table class="table table-bordered table-striped m-0">
                <thead>
                    <tr>
                        <th class="fit">&ensp;</th>
                        <th>Name</th>
                        <th>Subject</th>
                        <th class="fit" style="width: 176px;">At</th>
                        <th class="fit">Options</th>
                    </tr>        
                </thead>
                <tbody>
                    @if (Model.List.Count > 0)
                    {
                        foreach (var item in Model.List)
                        {
                            <tr>
                                <td class="fit" style="vertical-align: middle;">
                                    @if (item.ReadAt == null)
                                    {
                                        <i class="fas fa-fw fa-envelope" title="Unread"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-fw fa-envelope-open" title="Readed"></i>
                                    }
                                </td>
                                <td style="vertical-align: middle;" title="Name">
                                    @if (item.ReadAt == null)
                                    {
                                        <b>@item.Name</b>
                                    }
                                    else
                                    {
                                        <span>@item.Name</span>
                                    }
                                </td>
                                <td style="vertical-align: middle;" title="Subject">
                                    @if (item.ReadAt == null)
                                    {
                                        <b>@item.Subject</b>
                                    }
                                    else
                                    {
                                        <span>@item.Subject</span>
                                    }
                                </td>
                                <td class="fit" style="vertical-align: middle; width: 176px;" title="At">
                                    @if (item.ReadAt == null)
                                    {
                                        <b>@item.CreatedAt</b>
                                    }
                                    else
                                    {
                                        <span>@item.CreatedAt</span>
                                    }
                                </td>
                                <td class="fit" style="vertical-align: middle;">
                                    <div class="btn-group btn-group-sm">
                                        <a role="button" asp-action="details" asp-route-key="@item.Id" class="btn btn-light" title="Detail"><i class="d-inline fas fa-eye fa-fw"></i><span class="ml-1">Details</span></a>
                                        <button class="btn btn-danger" data-toggle="modal" data-target="#delete-@item.Id"><i class="d-inline fas fa-trash fa-fw"></i><span class="ml-1">Delete</span></button>
                                    </div>                                        
                                    <div class="modal fade" id="delete-@item.Id" tabindex="-1" role="dialog" aria-labelledby="delete-@item.Id-lable" aria-hidden="true">
                                        <div class="modal-dialog">
                                            @using (Html.BeginForm("delete", "commoncontactrecords", new { Area = "contacts" }, FormMethod.Post, true, new { @class = "modal-content" }))
                                            {
                                                @Html.Hidden("Id", item.Id)

                                                <div class="modal-header">
                                                    <h5 class="modal-title font-weight-bold text-primary" id="delete-@item.Id-lable">Delete common contact record</h5>
                                                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                                                </div>
                                                <div class="modal-body">
                                                    <p class="mb-0">Are you shure to delete selected common contact record?</p>
                                                </div>
                                                <div class="modal-footer" style="margin-top: 0;">
                                                    <button type="submit" class="btn btn-danger">Delete</button>
                                                    <button type="button" class="btn btn-light" data-dismiss="modal">Cancel</button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5"><p style="margin: 0 5px;" class="text-muted">No items to show</p></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
