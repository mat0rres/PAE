@using MOROPO.Framework.Guama.Core.Security.Common.Presentation.Web.Frontend.Extensions;
@using MOROPO.PremierAutomotiveExport.WebOlupin.Extensions;

@model MOROPO.PremierAutomotiveExport.WebOlupin.Models.View.Backend.HomeViewModel

@{
    ViewData["TITLE"] = ViewData["HEADER"] = GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer);

    Layout = "_BackendLayout";

    var monthNames = new string[] { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dic" };
}

@section styles {
    <link rel="stylesheet" href="~/vendor/apexcharts/apexcharts.css" />

    <style type="text/css">
        .card .fas {
            font-size: 32px;
        }
    </style>
}

@section scripts {
    <script type="text/javascript" src="~/vendor/apexcharts/apexcharts.min.js"></script>

    <script type="text/javascript">
        var userActivityLastDaysOptions = {
            series: [{
                name: 'Views',
                data: @Newtonsoft.Json.JsonConvert.SerializeObject(Model.WeekUserActivity.Select(_item => _item.Value).ToArray())
            }],
            chart: {
                height: 350,
                type: 'area'
            },
            dataLabels: {
                enabled: false
            },
            stroke: {
                curve: 'smooth'
            },
            xaxis: {
                type: 'int',
                categories: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.WeekUserActivity.Select(_item => _item.Key.ToString()).ToArray()))
            }
        };

        var userActivityLastDaysChart = new ApexCharts(document.querySelector("#user-activity-last-days-chart"), userActivityLastDaysOptions);

        userActivityLastDaysChart.render();

        var userActivityLastMonthOptions = {
            series: [{
                name: 'Views',
                data: @Newtonsoft.Json.JsonConvert.SerializeObject(Model.MonthUserActivity.Select(_item => _item.Value).ToArray())
            }],
            chart: {
                height: 350,
                type: 'area'
            },
            dataLabels: {
                enabled: false
            },
            stroke: {
                curve: 'smooth'
            },
            xaxis: {
                type: 'int',
                categories: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.MonthUserActivity.Select(_item => _item.Key).ToArray()))
            }
        };

        var userActivityLastMonthChart = new ApexCharts(document.querySelector("#user-activity-last-month-chart"), userActivityLastMonthOptions);

        userActivityLastMonthChart.render();

        var userActivityLastSemesterOptions = {
            series: [{
                name: 'Views',
                data: @Newtonsoft.Json.JsonConvert.SerializeObject(Model.SemesterUserActivity.Select(_item => _item.Value).ToArray())
            }],
            chart: {
                height: 350,
                type: 'area'
            },
            dataLabels: {
                enabled: false
            },
            stroke: {
                curve: 'smooth'
            },
            xaxis: {
                type: 'int',
                categories: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SemesterUserActivity.Select(_item => monthNames[_item.Key]).ToArray()))
            }
        };

        var userActivityLastSemesterChart = new ApexCharts(document.querySelector("#user-activity-last-semester-chart"), userActivityLastSemesterOptions);

        userActivityLastSemesterChart.render();

        var userActivityBySectionOptions = {
            series: @Newtonsoft.Json.JsonConvert.SerializeObject(Model.VisitsBySection),
            labels: ['About', 'News', 'Services', 'Products', 'Category', 'Brand', 'Contact'],
            chart: {
                type: 'polarArea',
            },
            stroke: {
                colors: ['#fff']
            },
            fill: {
                opacity: 0.8
            },
            colors: ['#008ffb', '#00e396', '#feb019', '#ff4560', '#775dd0', '#35b98f', '#f5a058'],
            responsive: [{
                breakpoint: 480,
                options: {
                    chart: {
                        width: 200
                    },
                    legend: {
                        position: 'bottom'
                    }
                }
            }]
        };

        var userActivityBySectionChart = new ApexCharts(document.querySelector("#user-activity-by-section-chart"), userActivityBySectionOptions);

        userActivityBySectionChart.render();

        const tabs = document.querySelector("#user-activity-tab");

        tabs.addEventListener('click', (e) => {
            let btn = e.target;

            const tabPaneId = btn.dataset.target;

            switch (tabPaneId) {
                case '#user-activity-last-month-chart':
                    userActivityLastMonthChart.resetSeries();

                    break;

                case '#user-activity-last-semester-chart':
                    userActivityLastSemesterChart.resetSeries();

                    break;
            }
        });
    </script>
}

<div class="row">
    <div class="col-md-6">
        <div class="card border-left-primary shadow-lg mb-4">
            <div class="card-body">
                <div class="row">
                    <div class="col-auto">
                        <i class="fas fa-shopping-cart text-primary fa-10x"></i>
                    </div>
                    <div class="col">
                        <h3 class="card-title text-primary">Product Request Contact</h3>
                        <div class="row">
                            <div class="col-sm-6">
                                <h5 class="float-md-left mb-md-0 font-weight-bold" style="color: black;">Unread:</h5>
                                <h2 class="display-2 mb-0 float-md-right">@Model.UnreadProductForContactRecordCount</h2>
                                <div class="clearfix"></div>
                            </div>
                            <div class="col-sm-6">
                                <h5 class="float-md-left mb-0 font-weight-bold" style="color: black;">This week:</h5>
                                <h2 class="display-2 mb-0 float-md-right">@Model.WeekProductForContactRecordCount</h2>
                                <div class="clearfix"></div>
                            </div>
                        </div>
                    </div>
                </div>            
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-left-info shadow-lg mb-4">
            <div class="card-body">
                <div class="row">
                    <div class="col-auto">
                        <i class="fas fa-envelope text-info fa-10x"></i>
                    </div>
                    <div class="col">
                        <h3 class="card-title text-info">General Propouse Contact</h3>
                        <div class="row">
                            <div class="col-sm-6">
                                <h5 class="float-md-left mb-md-0 font-weight-bold" style="color: black;">Unread:</h5>
                                <h2 class="display-2 mb-0 float-md-right">@Model.UnreadCommonContactRecordCount</h2>
                                <div class="clearfix"></div>
                            </div>
                            <div class="col-sm-6">
                                <h5 class="float-md-left mb-md-0 font-weight-bold" style="color: black;">This week:</h5>
                                <h2 class="display-2 mb-0 float-md-right">@Model.WeekCommonContactRecordCount</h2>
                                <div class="clearfix"></div>
                            </div>
                        </div>
                    </div>
                </div>            
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-lg mb-4">
            <div class="card-header">
                <h5 class="font-weight-bold text-primary">User Activity</h5>
                <ul id="user-activity-tab" class="nav nav-tabs card-header-tabs" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active" id="user-activity-last-days-chart-tab" data-toggle="tab" data-target="#user-activity-last-days-tab-pane" type="button" role="tab" aria-controls="user-activity-last-days-tab-pane" aria-selected="true">Last days</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" id="user-activity-last-month-chart-tab" data-toggle="tab" data-target="#user-activity-last-month-tab-pane" type="button" role="tab" aria-controls="user-activity-last-month-tab-pane" aria-selected="true">Last Month</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" id="user-activity-last-semester-chart-tab" data-toggle="tab" data-target="#user-activity-last-semester-tab-pane" type="button" role="tab" aria-controls="user-activity-last-semester-tab-pane" aria-selected="true">Las 6 months</button>
                    </li>
                </ul>
            </div>
            <div class="card-body">
                <div class="tab-content">
                    <div id="user-activity-last-days-tab-pane" class="tab-pane fade show active" role="tabpanel" aria-labelledby="user-activity-last-days-chart-tab">
                        <div id="user-activity-last-days-chart" style="min-height: 350px;"></div>
                    </div>
                    <div id="user-activity-last-month-tab-pane" class="tab-pane fade" role="tabpanel" aria-labelledby="user-activity-last-month-chart-tab">
                        <div id="user-activity-last-month-chart" style="min-height: 350px;"></div>
                    </div>
                    <div id="user-activity-last-semester-tab-pane" class="tab-pane fade" role="tabpanel" aria-labelledby="user-activity-last-semester-chart-tab">
                        <div id="user-activity-last-semester-chart" style="min-height: 350px;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-lg mb-4">
            <div class="card-header">
                <h5 class="font-weight-bold text-primary mb-0">Visits by section</h5>
                <small>Last 6 months</small>
            </div>
            <div class="card-body">
                <div id="user-activity-by-section-chart" style="min-height: 400px;"></div>
            </div>
        </div>
    </div>
</div>

<div id="management-sections" class="row">
    <div class="col-sm-6">
        @for (int i = 0; i < Model.Sections.Count; i += 2)
        {
            var group = Model.Sections.ElementAt(i);

            <div class="card shadow-lg mb-4">
                <div class="card-header"><h5 class="mb-0 font-weight-bold text-primary">@GlobalViewLocalizationHelper.Localize(group.Key)</h5></div>
                <div class="card-body">
                    @{
                        var total = group.Value.Count;
                        var count = 0;
                    }
                    @while (count < total)
                    {
                        var subList = group.Value.Skip(count).Take(3);

                        <div class="row">
                            @foreach (var item in subList)
                            {
                                <div class="col-sm-4" style="text-align: center; padding-bottom: 15px; padding-top: 15px;">
                                    @if (User.IsAuthorized(item.Role, Context))
                                    {
                                        <a href="@Url.Action(item.Action, item.Controller, new { item.Area })">
                                            <i class="@item.ToIconographyHtmlString()"></i>
                                            <div class="mt-1">@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</div>
                                        </a>
                                    }
                                    else
                                    {
                                        <div class="text-muted">
                                            <i class="@item.ToIconographyHtmlString()"></i>
                                            <div class="mt-1">@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        {
                            count += 3;
                        }
                    }
                </div>
            </div>
        }
    </div>
    <div class="col-sm-6">
        @if (Model.Sections.Count > 1)
        {
            for (int i = 1; i < Model.Sections.Count; i += 2)
            {
                var group = Model.Sections.ElementAt(i);

                <div class="card shadow-lg mb-4">
                    <div class="card-header"><h5 class="mb-0 font-weight-bold text-primary">@GlobalViewLocalizationHelper.Localize(group.Key)</h5></div>
                    <div class="card-body">
                        @{
                            var total = group.Value.Count;
                            var count = 0;
                        }
                        @while (count < total)
                        {
                            var subList = group.Value.Skip(count).Take(3);

                            <div class="row">
                                @foreach (var item in subList)
                                {
                                    <div class="col-sm-4" style="text-align: center; padding-bottom: 15px; padding-top: 15px;">
                                        @if (User.IsAuthorized(item.Role, Context))
                                        {
                                            <a href="@Url.Action(item.Action, item.Controller, new { item.Area })">
                                                <i class="@item.ToIconographyHtmlString()"></i>
                                                <div class="mt-1">@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</div>
                                            </a>
                                        }
                                        else
                                        {
                                            <div class="text-muted">
                                                <i class="@item.ToIconographyHtmlString()"></i>
                                                <div class="mt-1">@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            {
                                count += 3;
                            }
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>