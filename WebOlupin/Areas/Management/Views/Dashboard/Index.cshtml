@using MOROPO.Framework.Guama.Core.Security.Common.Presentation.Web.Frontend.Extensions;
@using MOROPO.PremierAutomotiveExport.WebOlupin.Extensions;

@model MOROPO.PremierAutomotiveExport.WebOlupin.Models.View.Backend.HomeViewModel

@{
    ViewData["TITLE"] = ViewData["HEADER"] = GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer);

    Layout = "_BackendLayout";
}

@section styles {
    <style type="text/css">
        .card .fas {
            font-size: 32px;
        }
    </style>
}

<div id="management-sections" class="row">
    <div class="col-sm-6">
        @for (int i = 0; i < Model.Sections.Count; i += 2)
        {
            var group = Model.Sections.ElementAt(i);

            <div class="card shadow-lg mb-4">
                <div class="card-header"><h5 class="mb-0 font-weight-bold text-primary">@GlobalViewLocalizationHelper.Localize(group.Key)</h5></div>
                <div class="card-body">
                    @{
                        var total = group.Value.Count;
                        var count = 0;
                    }
                    @while (count < total)
                    {
                        var subList = group.Value.Skip(count).Take(3);

                        <div class="row">
                            @foreach (var item in subList)
                            {
                                <div class="col-sm-4" style="text-align: center; padding-bottom: 15px; padding-top: 15px;">
                                    @if (User.IsAuthorized(item.Role))
                                    {
                                        <a href="@Url.Action(item.Action, item.Controller, new { item.Area })">
                                            <i class="@item.ToIconographyHtmlString()"></i>
                                            <div class="mt-1">@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</div>
                                        </a>
                                    }
                                    else
                                    {
                                        <div class="text-muted">
                                            <i class="@item.ToIconographyHtmlString()"></i>
                                            <div class="mt-1">@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        {
                            count += 3;
                        }
                    }
                </div>
            </div>
        }
    </div>
    <div class="col-sm-6">
        @if (Model.Sections.Count > 1)
        {
            for (int i = 1; i < Model.Sections.Count; i += 2)
            {
                var group = Model.Sections.ElementAt(i);

                <div class="card shadow-lg mb-4">
                    <div class="card-header"><h5 class="mb-0 font-weight-bold text-primary">@GlobalViewLocalizationHelper.Localize(group.Key)</h5></div>
                    <div class="card-body">
                        @{
                            var total = group.Value.Count;
                            var count = 0;
                        }
                        @while (count < total)
                        {
                            var subList = group.Value.Skip(count).Take(3);

                            <div class="row">
                                @foreach (var item in subList)
                                {
                                    <div class="col-sm-4" style="text-align: center; padding-bottom: 15px; padding-top: 15px;">
                                        @if (User.IsAuthorized(item.Role))
                                        {
                                            <a href="@Url.Action(item.Action, item.Controller, new { item.Area })">
                                                <i class="@item.ToIconographyHtmlString()"></i>
                                                <div class="mt-1">@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</div>
                                            </a>
                                        }
                                        else
                                        {
                                            <div class="text-muted">
                                                <i class="@item.ToIconographyHtmlString()"></i>
                                                <div class="mt-1">@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            {
                                count += 3;
                            }
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>