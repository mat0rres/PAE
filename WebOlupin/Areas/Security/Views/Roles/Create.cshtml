@model MOROPO.Framework.Guama.Core.Security.Common.Presentation.Web.Backend.Models.View.RoleInputViewModel

@{
    const string TITLE = "Agregar Rol";
    const string HEADER = "Administración de Roles";

    ViewData["TITLE"] = TITLE;
    ViewData["HEADER"] = HEADER;

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<i class=\"fas fa-fw fa-tachometer-alt\"></i> " + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = Url.Action("Index", "Dashboard", new { Area = "management" })
        },
        new BreadcrumbViewModel
        {
            Caption = HEADER,
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = TITLE
        }
    };

    Layout = "_BackendLayout";
}

<hr class="mt-0 mb-4" />

@using (Html.BeginForm("create", "roles", new { Area = "security" }, FormMethod.Post, true, null))
{
    @Html.ValidationSummary(true)

    <div class="card mb-3">
        <div class="card-header"><h5 class="mb-0 font-weight-bold text-primary">@TITLE</h5></div>

        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.Name, new { @class = "control-label" })
                    @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Name, null, new { @class = "text-danger" })
                </div>
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.Description, new { @class = "control-label" })
                @Html.TextAreaFor(model => model.Description, 4, 0, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Description, null, new { @class = "text-danger" })
            </div>

            <div class="card">
                <div class="card-header">Permisos</div>

                <div class="card-body">
                    @if (Model.GroupedSelectablePermissions.Length > 0 || Model.UngroupedSelectablePermissions.Length > 0)
                    {
                        var index = 0;

                        <div class="row">
                            @foreach (var item in Model.UngroupedSelectablePermissions)
                            {
                                <div class="col-md-6">
                                    @Html.EditorFor(model => item, "SelectionDescriptedIntIDItemInputViewModel", string.Format("UngroupedSelectablePermissions[{0}]", index++))
                                </div>
                            }
                        </div>

                        foreach (var group in Model.GroupedSelectablePermissions)
                        {
                            <fieldset>
                                <legend class="border-bottom">@GlobalViewLocalizationHelper.Localize(group.Key)</legend>
                                <div class="row">
                                    @foreach (var item in group.Value)
                                    {
                                        <div class="col-md-6">
                                            @Html.EditorFor(model => item, "SelectionDescriptedIntIDItemInputViewModel", string.Format("UngroupedSelectablePermissions[{0}]", index++))
                                        </div>
                                    }
                                </div>
                            </fieldset>
                        }
                    }
                    else
                    {
                        <div>Sin elementos que mostrar.</div>
                    }
                </div>
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Agregar</button>
            <a class="btn btn-secondary" href="@Url.Action("index")">Cancelar</a>
        </div>
    </div>
}