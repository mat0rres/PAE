@model MOROPO.Framework.Guama.Core.Presentation.Web.Frontend.Models.View.PaginationViewModel<MOROPO.Framework.Guama.Core.Persistence.ORM.EF.Entities.Trace, long, MOROPO.PremierAutomotiveExport.WebOlupin.Models.View.Backend.TraceDisplayViewModel>

@{
    const string HEADER = "Visualización de Registros";

    ViewData["TITLE"] = ViewData["HEADER"] = HEADER;

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<i class=\"fas fa-fw fa-tachometer-alt\"></i> " + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = Url.Action("Index", "Dashboard", new { Area = "management" })
        },
        new BreadcrumbViewModel
        {
            Caption = HEADER
        }
    };

    Layout = "_BackendLayout";
}

@section styles {
    <style type="text/css">
        dd {
            word-wrap: break-word;
        }        
    </style>
}

<hr class="mt-0 mb-4" />

<div class="row mb-3">
    <div class="col-sm-4">
        @await Html.PartialAsync("_TracesFilterPartial", Model.Filter)
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        <h5 class="m-0 font-weight-bold text-primary">Listado de registros</h5>
    </div>
    <div class="card-body">
        @if (Model.HasNext || Model.HasPrevious)
        {
            var paginationStart = (Model.Page - 1) * Model.Limit + 1;
            var paginationEnd = paginationStart - 1 + Model.List.Count;

            <div class="row">
                <div class="col mb-2">
                    <span style="font-weight: 600;">Mostrando página @Model.Page</span>: del @paginationStart al @paginationEnd, <span style="font-weight: 600;">Total de páginas</span>: @Model.MaxPageCount
                </div>
                <div class="col-auto mb-2">
                    <ul class="pagination">
                        @if (Model.HasPrevious)
                        {
                            <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", Model.Page - 1}})">&laquo;</a></li>
                        }
                        else
                        {
                            <li class="disabled page-item"><a class="page-link" href="#">&laquo;</a></li>
                        }

                        @if (Model.MaxPageCount > 5)
                        {
                            if (Model.Page > 3)
                            {
                                if (Model.MaxPageCount - Model.Page < 3)
                                {
                                    for (var i = Model.MaxPageCount - 4; i <= Model.MaxPageCount; i++)
                                    {
                                        if (i == Model.Page)
                                        {
                                            <li class="active page-item"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                                        }
                                        else
                                        {
                                            <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                        }
                                    }
                                }
                                else
                                {
                                    for (var i = Model.Page - 2; i <= Model.Page + 2; i++)
                                    {
                                        if (i == Model.Page)
                                        {
                                            <li class="active page-item"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                                        }
                                        else
                                        {
                                            <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                        }
                                    }
                                }
                            }
                            else
                            {
                                for (var i = 1; i <= 5; i++)
                                {
                                    if (i == Model.Page)
                                    {
                                        <li class="active page-item"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                                    }
                                    else
                                    {
                                        <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                    }
                                }
                            }
                        }
                        else
                        {
                            for (var i = 1; i <= Model.MaxPageCount; i++)
                            {
                                if (i == Model.Page)
                                {
                                    <li class="active page-item"><a class="page-link" href="#">@i <span class="sr-only">(current)</span></a></li>
                                }
                                else
                                {
                                    <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", i}})">@i</a></li>
                                }
                            }
                        }

                        @if (Model.HasNext)
                        {
                            <li class="page-item"><a class="page-link" href="@Url.Action(Model.Action, new Microsoft.AspNetCore.Routing.RouteValueDictionary(Model.RouteValues) {{"sheet", Model.Page + 1}})">&raquo;</a></li>
                        }
                        else
                        {
                            <li class="disabled page-item"><a class="page-link" href="#">&raquo;</a></li>
                        }
                    </ul>
                </div>
            </div>
        }

        <div style="border: 1px solid #DDD; border-radius: 4px;">
            <table class="table table-bordered table-striped m-0">
                <thead>
                    <tr>
                        <th>Autor</th>
                        <th>Registro</th>
                        <th>Tipo</th>
                        <th>Entidad</th>
                        <th class="fit">Opciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.List.Count > 0)
                    {
                        foreach (var item in Model.List)
                        {
                            var entityName = item.EntityName.ToString().Split('.').Last();

                            <tr>
                                <td style="vertical-align: middle;">@item.Author</td>
                                <td style="vertical-align: middle;">@item.Registered.ToString()</td>
                                <td style="vertical-align: middle;">@item.Type.ToString()</td>
                                <td style="vertical-align: middle;">@entityName</td>
                                <td class="fit" style="vertical-align: middle;">
                                   <button class="btn btn-sm btn-light" data-toggle="modal" data-target="#descrip-@item.Id"><i class="d-inline fas fa-eye fa-fw"></i><span class="ml-1">Detalles</span></button>
                                    <div class="modal fade " id="descrip-@item.Id" tabindex="-1" role="dialog" aria-labelledby="descrip-@item.Id-label" aria-hidden="true">
                                        <div class="modal-dialog modal-lg" role="document">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title font-weight-bold text-primary" id="descrip-@item.Id-label">Detalles</h5>
                                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                        <span aria-hidden="true">&times;</span>
                                                    </button>
                                                </div>
                                                <div class="modal-body">
                                                    <dl>
                                                        <dt>Entidad</dt>
                                                        <dd>@Html.DisplayName(@entityName)</dd>
                                                        <dt>Estado inicial</dt>
                                                        <dd><pre>@Html.Raw(item.BeforeData)</pre></dd>
                                                        <dt>Estado final</dt>
                                                        <dd><pre>@Html.Raw(item.AfterData)</pre></dd>
                                                    </dl>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5"><p style="margin: 0 5px;" class="text-muted">Sin elementos que mostrar</p></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>