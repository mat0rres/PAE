@model MOROPO.Framework.Guama.Security.Personal.Presentation.Web.Backend.Models.Filter.UsersFilterModel

@using (Html.BeginForm("filter", "users", new { Area = "security" }, FormMethod.Post, true, null))
{
    <div class="card">
        @if (Model == null || string.IsNullOrEmpty(Model.Id))
        {
            <a href="#filter-form-body" class="d-block card-header py-3 collapsed" data-toggle="collapse" role="button" aria-expanded="true" aria-controls="filter-form-body">
                <h6 class="mb-0 font-weight-bold text-primary">List filter</h6>
            </a>
            <div id="filter-form-body" class="collapse">
                <div class="card-body">
                    <div>
                        @Html.Label("Id", "Username", new { @class = "control-label" })
                        @Html.TextBoxFor(model => model.Id, new { @class = "form-control" })
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-fw fa-filter"></i> Filter</button>
                    <button type="button" class="btn btn-sm btn-secondary disabled"><i class="fas fa-fw fa-times-circle"></i> Clean</button>
                </div>
            </div>
        }
        else
        {
            <a href="#filter-form-body" class="d-block card-header py-3" data-toggle="collapse" role="button" aria-expanded="true" aria-controls="filter-form-body">
                <h6 class="mb-0 font-weight-bold text-primary">List filter</h6>
            </a>
            <div id="filter-form-body" class="collapse show">
                <div class="card-body">
                    <div>
                        @Html.Label("Id", "Username", new { @class = "control-label" })
                        @Html.TextBoxFor(model => model.Id, new { @class = "form-control" })
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-fw fa-filter"></i> Filter</button>
                    <button type="button" class="btn btn-sm btn-secondary filter-form-reseter"><i class="fas fa-fw fa-times-circle"></i> Clean</button>
                </div>
            </div>
        }
    </div>
}