@model MOROPO.PremierAutomotiveExport.WebOlupin.Models.View.Backend.PageHeaderInputViewModel

@{
    const string TITLE = "Create Page Header";
    const string HEADER = "Page Header's management";

    ViewData["TITLE"] = TITLE;
    ViewData["HEADER"] = HEADER;

    ViewData[BreadcrumbViewModel.BREADCRUMBS_MAP_KEY] = new List<BreadcrumbViewModel>
    {
        new BreadcrumbViewModel
        {
            Caption = "<i class=\"fas fa-fw fa-tachometer-alt\"></i> " + GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer),
            Url = Url.Action("Index", "Dashboard", new { Area = "management" })
        },
        new BreadcrumbViewModel
        {
            Caption = HEADER,
            Url = Url.Action("index")
        },
        new BreadcrumbViewModel
        {
            Caption = TITLE
        }
    };

    Layout = "_BackendLayout";
}

@section styles {
    <style type="text/css">
        #ImageFile {
            width: 0;
            height: 0;
            overflow: hidden;
        }
    </style>
}

@section scripts {
    <script type="text/javascript" src="/vendor/ckeditor/ckeditor.js"></script>

    <script type="text/javascript">
        $(function () {
            $(document).on("change", "#ImageFile", function () {
                var files = !!this.files ? this.files : [];

                if (!files.length || !window.FileReader) return; // no file selected, or no FileReader support

                if (/^image/.test(files[0].type)) {
                    var reader = new FileReader();

                    reader.readAsDataURL(files[0]);

                    reader.onloadend = function () {
                        $('#ImageFilePreview').attr('src', this.result);
                    }
                }

            });
        });
    </script>
}

<hr class="mt-0 mb-4" />

@using (Html.BeginForm("create", "pageheaders", new { Area = "site" }, FormMethod.Post, true, new { enctype = "multipart/form-data" }))
{
    @Html.ValidationSummary(true)

    <div class="card mb-4">
        <div class="card-header"><h5 class="mb-0 font-weight-bold text-primary">@TITLE</h5></div>

        <div class="card-body">
            <div class="mb-3">
                @Html.LabelFor(model => model.Id, new { @class = "control-label" })
                @Html.DropDownListFor(model => model.Id, Model.AvailablePageIdSelectListItems, new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.Id, null, new { @class = "text-danger" })
            </div>
            <div>
                <div class="card">
                    <img class="card-img-top" style="min-height: 48px; background-color: gray;" id="ImageFilePreview" />
                    <label class="btn btn-light" style="border-top-left-radius: 0; border-top-right-radius: 0; margin-bottom: 0;">
                        @GlobalViewLocalizationHelper.Localize("Upload", ViewLocalizer) ...
                        @Html.EditorFor(model => model.ImageFile)
                    </label>
                </div>
                @Html.ValidationMessageFor(model => model.ImageFile, null, new { @class = "text-danger" })
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Agregar</button>
            <a class="btn btn-secondary" href="@Url.Action("index")">Cancelar</a>
        </div>
    </div>
}