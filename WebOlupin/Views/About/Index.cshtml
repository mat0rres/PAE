@model MOROPO.PremierAutomotiveExport.WebOlupin.Models.View.Frontend.AboutIndexViewModel

@{
    ViewData["Title"] = "Nosotros";

    Layout = "_FrontendLayout";
}

<div class="ahead-picture" style="background-image: url('/img/about-ahead-picture.jpg')"></div>

<div class="container">
    <div class="text-center">
        <h1 class="display-4 my-5">Nosotros</h1>
    </div>

    <div class="row mt-4">
        <div class="col-sm-4">
            <img class="img-fluid" title="Premier Automotive Export" src="/img/founders.jpg" />
        </div>
        <div class="col-sm-8">
            @Html.Raw(Model.MainTextBlock.Content)
        </div>
    </div>

    @foreach (var item in Model.Representatives)
    {
        <hr class="mt-5 mb-0" />

        <div class="row mt-5">
            <div class="col-sm-4">
                <div class="pl-5">
                    <img class="img-fluid" title="@item.Fullname" src="/media/images/@item.Image.Id.@item.Image.Extension" />
                </div>
            </div>
            <div class="col-sm-8">
                <div class="pr-5">
                    <h4 class="mb-4">@item.Fullname<span class="font-weight-normal"> | @item.Position</span></h4>
                    @Html.Raw(item.About)
                </div>
            </div>
        </div>
    }
</div>