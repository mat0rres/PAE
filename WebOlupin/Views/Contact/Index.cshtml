@model MOROPO.PremierAutomotiveExport.WebOlupin.Models.View.Frontend.ContactIndexViewModel

@{
    ViewData["Title"] = "Contacto";

    Layout = "_FrontendLayout";
}

@if (Model.Header != null)
{
    <div class="ahead-picture" style="background-image: url('/media/images/@Model.Header.Image.Id.@Model.Header.Image.Extension')"></div>
}
else
{
    <div class="ahead-picture" style="background-image: url('/img/contact-aheat-picture.jpg')"></div>
}

<div class="container">
    <div class="text-center">
        <h1 class="display-4 my-5">Contactar</h1>
    </div>

    @{
        var notificationEntries = TempData.Where(x => x.Key.EndsWith("-notification")).ToArray();

        foreach (var extraNotificationEntry in notificationEntries)
        {
            var notification = JsonConvert.DeserializeObject<NotificationViewModel>(extraNotificationEntry.Value.ToString());

            <div class="alert alert-dismissible fade show alert-@Html.Raw(notification.Type.ToString().ToLower()) mb-5">
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                @if (notification.Title != null)
                {
                    <h4>@GlobalViewLocalizationHelper.Localize(notification.Title, ViewLocalizer)</h4>
                }

                @if (notification.Message != null)
                {
                    @Html.Raw(GlobalViewLocalizationHelper.Localize(notification.Message, ViewLocalizer))
                    ;
                }

                @if (notification.Messages != null)
                {
                    <ul>
                        @foreach (var item in notification.Messages)
                        {
                            <li>@GlobalViewLocalizationHelper.Localize(item, ViewLocalizer)</li>
                        }
                    </ul>
                }
            </div>
        }
    }

    <div class="row">
        <div class="col-md-5">
            @Html.Raw(Model.RichTextBlock.Content)
        </div>
        <div class="col-md-7">
            <partial name="_CreateCommonContactRecordPartial" model="new MOROPO.PremierAutomotiveExport.WebOlupin.Models.View.CommonContactRecordInputViewModel()" />
        </div>
    </div>
</div>