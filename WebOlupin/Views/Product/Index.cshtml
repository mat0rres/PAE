@model MOROPO.PremierAutomotiveExport.WebOlupin.Models.View.Frontend.ProductDetailViewModel

@{
    ViewData["Title"] = string.Format("{0} {1}", Model.Product.Brand.Name, Model.Product.Model);

    Layout = "_FrontendLayout";
}

@if (Model.Header != null)
{
    <div class="ahead-picture" style="background-image: url('/media/images/@Model.Header.Image.Id.@Model.Header.Image.Extension')"></div>
}
else
{
    <div class="ahead-picture" style="background-image: url('/img/home-ahead-picture.jpg')"></div>
}

<div class="container">
    <div class="text-center my-5">
        @if (!string.IsNullOrEmpty(Model.Referer))
        {
            <a class="btn btn-light float-left" href="@Model.Referer"><i class="fas fa-angle-left fa-fw"></i> Regresar</a>
        }
        <h1 class="display-4">Producto</h1>
    </div>

    <div class="clearfix"></div>

    @{
        var notificationEntries = TempData.Where(x => x.Key.EndsWith("-notification")).ToArray();

        foreach (var extraNotificationEntry in notificationEntries)
        {
            var notification = JsonConvert.DeserializeObject<NotificationViewModel>(extraNotificationEntry.Value.ToString());

            <div class="alert alert-dismissible fade show alert-@Html.Raw(notification.Type.ToString().ToLower()) mb-5">
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                @if (notification.Title != null)
                {
                    <h4>@GlobalViewLocalizationHelper.Localize(notification.Title, ViewLocalizer)</h4>
                }

                @if (notification.Message != null)
                {
                    @Html.Raw(GlobalViewLocalizationHelper.Localize(notification.Message, ViewLocalizer))
                    ;
                }

                @if (notification.Messages != null)
                {
                    <ul>
                        @foreach (var item in notification.Messages)
                        {
                            <li>@GlobalViewLocalizationHelper.Localize(item, ViewLocalizer)</li>
                        }
                    </ul>
                }
            </div>
        }
    }

    <div class="row">
        <div class="col-md-4">
            <img class="img-fluid" title="@Model.Product.Model" src="/media/images/@Model.Product.FeatureImage.Id.@Model.Product.FeatureImage.Extension" />
        </div>
        <div class="col-md-5">
            <h1 class="display-3 mb-4">@Model.Product.Model</h1>

            <div class="my-4">
                @foreach (var item in Model.Attributes)
                {
                    <div><span class="font-weight-bold">@item.CustomAttributeName:</span> @item.Value</div>
                }
            </div>

            <div class="mb-4">
                <h5>Caracter&iacute;sticas:</h5>

                <ul>
                    @foreach (var item in Model.Features)
                    {
                        <li>@item.Description</li>
                    }
                </ul>
            </div>

            @if (!string.IsNullOrEmpty(Model.Product.Description))
            {
                <p>@Html.Raw(Model.Product.Description)</p>
            }

            @if (Model.Colors.Length > 0)
            {
                <h5 class="mb-3">Colores disponibles:</h5>

                <div class="row">
                    @foreach (var item in Model.Colors)
                    {
                        <div class="col-md-4 col-sm-6 text-center">
                            <div class="img-thumbnail d-inline-block shadow-sm" style="width: 48px; height: 48px; background-color: @item.Color;"></div>
                            <p class="mb-3">@item.Label</p>
                        </div>
                    }
                </div>
            }
        </div>
        <div class="col-md-3">
            <img class="img-fluid mb-2" title="@Model.Product.Brand.Name" src="/media/images/@Model.Product.Brand.Image.Id.@Model.Product.Brand.Image.Extension" />

            @foreach (var item in Model.ExtraImages)
            {
                <img class="img-fluid img-thumbnail mt-3" title="@Model.Product.Model" src="/media/images/@item.Id.@item.Extension" />
            }
        </div>
    </div>
</div>
<div class="jumbotron m-sm-5 py-sm-5">
    <div class="row">
        <div class="col-md-4 col-sm-12">
            <h4 class="display-4">Interesado?</h4>
            <p class="lead">Llene este formulation para que nuestro equipo de ventas se ponga en contacto y lo asista</p>
        </div>
        <div class="col-md-8 col-sm-12">
            <partial name="_CreateProductForContactRecordPartial" model="new MOROPO.PremierAutomotiveExport.WebOlupin.Models.View.ProductForContactRecordInputViewModel { ProductId = Model.Product.Id, ProductBrandName = Model.Product.Brand.Name, ProductModel = Model.Product.Model, ProductFeatureImage = Model.Product.FeatureImage, AvailableColorSelectListItems = Model.Colors.Select(_item => new SelectListItem { Value = _item.Id.ToString(), Text = _item.Label }).ToArray() }" />
        </div>
    </div>
</div>