@model MOROPO.PremierAutomotiveExport.WebOlupin.Models.View.ProductForContactRecordInputViewModel

<form method="post" asp-action="contact" asp-controller="product" asp-antiforgery="true">
    @Html.HiddenFor(model => model.ProductId)
    
    <div class="row">
        <div class="col-md-6 mb-3">
            @Html.LabelFor(model => model.Name)
            @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
        </div>
        <div class="col-md-6 mb-3">
            @Html.LabelFor(model => model.LastName)
            @Html.TextBoxFor(model => model.LastName, new { @class = "form-control" })
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            @Html.LabelFor(model => model.EmailAddress)
            @Html.TextBoxFor(model => model.EmailAddress, new { @class = "form-control" })
        </div>
        <div class="col-md-6 mb-3">
            @Html.LabelFor(model => model.PhoneNumber)
            @Html.TextBoxFor(model => model.PhoneNumber, new { @class = "form-control" })
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            @Html.LabelFor(model => model.CI)
            @Html.TextBoxFor(model => model.CI, new { @class = "form-control" })
        </div>
        <div class="col-md-6 mb-3">
            @Html.LabelFor(model => model.City)
            @Html.TextBoxFor(model => model.City, new { @class = "form-control" })
        </div>
    </div>
    <div class="mb-3">
        @Html.LabelFor(model => model.PostalAddress)
        @Html.TextAreaFor(model => model.PostalAddress, 4, 1, new { @class = "form-control" })
    </div>
    <div class="mb-3">
        @Html.LabelFor(model => model.Message, "Especificaciones (opcional)")
        @Html.TextAreaFor(model => model.Message, 6, 1, new { @class = "form-control" })
    </div>

    <input type="submit" class="btn btn-success" value="Enviar" />
</form>
