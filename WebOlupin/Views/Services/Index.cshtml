@model MOROPO.PremierAutomotiveExport.WebOlupin.Models.View.Frontend.ServicesIndexViewModel

@{
    ViewData["Title"] = "Services";

    Layout = "_FrontendLayout";
}

@if (Model.Header != null)
{
    <div class="ahead-picture" style="background-image: url('/media/images/@Model.Header.Image.Id.@Model.Header.Image.Extension')"></div>
}
else
{
    <div class="ahead-picture" style="background-image: url('/img/about-ahead-picture.jpg')"></div>
}

<div class="container">
    <div class="text-center">
        <h1 class="display-4 my-5">Services</h1>
    </div>

    @foreach (var item in Model.Items)
    {
        <div class="row mt-5">
            <div class="col-sm-4">
                <img class="img-fluid mb-3 mb-md-0" src="/media/images/@item.FeatureImage.Id.@item.FeatureImage.Extension" title="@item.Name" />
            </div>
            <div class="col-sm-8">
                <h3 class="mb-4">@item.Name</h3>
                @Html.Raw(item.Description)
            </div>
        </div>
    }
</div>