@using MOROPO.Framework.Guama.Core.Security.Common.Presentation.Web.Frontend.Extensions
@using MOROPO.PremierAutomotiveExport.WebOlupin.Extensions;

@model MOROPO.PremierAutomotiveExport.WebOlupin.Models.View.Backend.ManagementDashboardViewModel

<ul class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion" id="accordionSidebar">

    <!-- Sidebar - Brand -->

    <img class="img-fluid mx-3 mt-3 mb-0" src="/img/PAE-logo_d400_hight_contrast_light.png" title="Premier Automotive Export" />
    <div class="sidebar-brand p-0 pb-3 h-auto" href="#">
        <div class="sidebar-brand-text px-3 py-0">
            <p class="mb-0">WEB SITE</p>
            <p class="mb-0">BACKOFFICE</p>
        </div>
    </div>

    <!-- Divider -->
    <hr class="sidebar-divider my-0">

    <!-- Nav Item - Dashboard -->
    @if (Context.Request.Path.Value == "/management/dashboard")
    {
        <li class="nav-item active">
            <a class="nav-link" asp-action="index" asp-controller="dashboard" asp-area="management">
                <i class="fas fa-fw fa-tachometer-alt"></i>
                <span>@GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer)</span>
            </a>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link" asp-action="index" asp-controller="dashboard" asp-area="management">
                <i class="fas fa-fw fa-tachometer-alt"></i>
                <span>@GlobalViewLocalizationHelper.Localize("Dashboard", ViewLocalizer)</span>
            </a>
        </li>
    }

    @foreach (var group in Model.Sections)
    {
        <!-- Divider -->
        <hr class="sidebar-divider">

        <!-- Heading -->
        <div class="sidebar-heading">@group.Key</div>

        @foreach (var item in group.Value)
        {
            if (User.IsAuthorized(item.Role, Context))
            {
                if (Context.Request.Path.Value.StartsWith("/management/" + item.Area + "/" + item.Controller))
                {
                    <li class="nav-item active">
                        <a class="nav-link" asp-action="@item.Action" asp-controller="@item.Controller" asp-area="@item.Area" asp-route-sheet="">
                            <i class="@item.ToIconographyHtmlString()"></i>
                            <span>@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</span>
                        </a>
                    </li>
                }
                else if (string.IsNullOrEmpty(item.Area) && Context.Request.Path.Value.StartsWith("/management/" + item.Controller))
                {
                    <li class="nav-item active">
                        <a class="nav-link" asp-action="@item.Action" asp-controller="@item.Controller" asp-area="@item.Area" asp-route-sheet="">
                            <i class="@item.ToIconographyHtmlString()"></i>
                            <span>@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</span>
                        </a>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-action="@item.Action" asp-controller="@item.Controller" asp-area="@item.Area" asp-route-sheet="">
                            <i class="@item.ToIconographyHtmlString()"></i>
                            <span>@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</span>
                        </a>
                    </li>
                }
            }
            else
            {
                <li class="nav-item disabled">
                    <a class="nav-link" href="#">
                        <i class="@item.ToIconographyHtmlString()"></i>
                        <span>@GlobalViewLocalizationHelper.Localize(item.Title, ViewLocalizer)</span>
                    </a>
                </li>
            }
        }
    }

    <!-- Divider -->
    <hr class="sidebar-divider d-none d-md-block">

    <!-- Sidebar Toggler (Sidebar) -->
    <div class="text-center d-none d-md-inline">
        <button class="rounded-circle border-0" id="sidebarToggle"></button>
    </div>
</ul>
