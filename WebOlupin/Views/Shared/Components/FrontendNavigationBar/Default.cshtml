@model MOROPO.PremierAutomotiveExport.WebOlupin.Models.View.CategoryDisplayViewModel[]

<div class="navbar navbar-light fixed-top bg-white shadow-lg py-0 py-md-4">
    <div class="container d-md-none">
        <a class="navbar-brand" href="/"><img class="m-3" style="width: 196px;" title="Premier Automotive Export" src="/img/PAE-logo_d400.png" /></a>
        <button class="navbar-toggler d-md-none" type="button" data-toggle="collapse" data-target="#navbar-toggler-menu" aria-controls="navbar-toggler-menu" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbar-toggler-menu">
            <ul class="navbar-nav mr-auto mt-2 mb-3">
                <li class="nav-item">
                    @if (Context.Request.Path.Value == "/")
                    {
                        <a class="nav-link active" asp-action="index" asp-controller="home">INICIO</a>
                    }
                    else
                    {
                        <a class="nav-link" asp-action="index" asp-controller="home">INICIO</a>
                    }
                </li>
                <li class="nav-item">
                    @if (Context.Request.Path.Value.StartsWith("/about"))
                    {
                        <a class="nav-link active" asp-action="index" asp-controller="about">NOSOTROS</a>
                    }
                    else
                    {
                        <a class="nav-link" asp-action="index" asp-controller="about">NOSOTROS</a>
                    }
                </li>
                <li class="nav-item">
                    @if (Context.Request.Path.Value.StartsWith("/news"))
                    {
                        <a class="nav-link active" asp-action="index" asp-controller="news">NOTICIAS</a>
                    }
                    else
                    {
                        <a class="nav-link" asp-action="index" asp-controller="news">NOTICIAS</a>
                    }
                </li>
                <li class="nav-item">
                    @if (Context.Request.Path.Value.StartsWith("/services"))
                    {
                        <a class="nav-link active" asp-action="index" asp-controller="services">SERVICIOS</a>
                    }
                    else
                    {
                        <a class="nav-link" asp-action="index" asp-controller="services">SERVICIOS</a>
                    }
                </li>
                @foreach (var item in Model)
                {
                    <li class="nav-item">
                        @if (Context.Request.Path.Value == string.Format("/category/{0}", item.Id))
                        {
                            <a class="nav-link active" asp-action="index" asp-controller="category" asp-route-key="@item.Id">@item.Name</a>
                        }
                        else
                        {
                            <a class="nav-link" asp-action="index" asp-controller="category" asp-route-key="@item.Id">@item.Name</a>
                        }
                    </li>
                }
                <li class="nav-item">
                    @if (Context.Request.Path.Value.StartsWith("/contact"))
                    {
                        <a class="nav-link active" asp-action="index" asp-controller="contact">CONTACTO</a>
                    }
                    else
                    {
                        <a class="nav-link" asp-action="index" asp-controller="contact">CONTACTO</a>
                    }
                </li>
            </ul>
        </div>
    </div>
    <div class="container d-none d-md-block">
        <div class="text-center">
            <a href="/"><img class="m-3" style="width: 278px;" title="Premier Automotive Export" src="/img/PAE-logo_d400.png" /></a>
        </div>
        <ul class="nav nav-pills nav-fill mt-4">
            <li class="nav-item">
                @if (Context.Request.Path.Value == "/")
                {
                    <a class="nav-link active" asp-action="index" asp-controller="home">INICIO</a>
                }
                else
                {
                    <a class="nav-link" asp-action="index" asp-controller="home">INICIO</a>
                }
            </li>
            <li class="nav-item">
                @if (Context.Request.Path.Value.StartsWith("/about"))
                {
                    <a class="nav-link active" asp-action="index" asp-controller="about">NOSOTROS</a>
                }
                else
                {
                    <a class="nav-link" asp-action="index" asp-controller="about">NOSOTROS</a>
                }
            </li>
            <li class="nav-item">
                @if (Context.Request.Path.Value.StartsWith("/news"))
                {
                    <a class="nav-link active" asp-action="index" asp-controller="news">NOTICIAS</a>
                }
                else
                {
                    <a class="nav-link" asp-action="index" asp-controller="news">NOTICIAS</a>
                }
            </li>
            <li class="nav-item">
                @if (Context.Request.Path.Value.StartsWith("/services"))
                {
                    <a class="nav-link active" asp-action="index" asp-controller="services">SERVICIOS</a>
                }
                else
                {
                    <a class="nav-link" asp-action="index" asp-controller="services">SERVICIOS</a>
                }
            </li>
            @foreach (var item in Model)
            {
                <li class="nav-item">
                    @if (Context.Request.Path.Value == string.Format("/category/{0}", item.Id))
                    {
                        <a class="nav-link active" asp-action="index" asp-controller="category" asp-route-key="@item.Id">@item.Name</a>
                    }
                    else
                    {
                        <a class="nav-link" asp-action="index" asp-controller="category" asp-route-key="@item.Id">@item.Name</a>
                    }
                </li>
            }
            <li class="nav-item">
                @if (Context.Request.Path.Value.StartsWith("/contact"))
                {
                    <a class="nav-link active" asp-action="index" asp-controller="contact">CONTACTO</a>
                }
                else
                {
                    <a class="nav-link" asp-action="index" asp-controller="contact">CONTACTO</a>
                }
            </li>
        </ul>
    </div>
</div>
