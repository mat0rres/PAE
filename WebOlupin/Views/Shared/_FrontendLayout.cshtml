@{ 
    Layout = "_Layout";
}

@section styles {
    <link href="/css/frontend.css" rel="stylesheet" type="text/css" />

    @RenderSection("styles", false)
}

@await Component.InvokeAsync("FrontendNavigationBar")

<section id="content-section" class="mb-4">
    @RenderBody()
</section>
<a href="/doc/PremierAutomotiveExport_Capability Statement.pdf">
    <div style="background-color: forestgreen;">
        <div class="container" style="margin-top: 80px;">
            <div class="row">
                <div class="col-10"></div>
                <div class="col-2 p-5">
                    <img class="img-fluid" title="Premier Automotive Export" src="/img/certification.png" />
                </div>
            </div>
        </div>
    </div>
</a>
<div class="p-4 text-center" style="background-color: rgb(51, 153, 0); color: white;">© @System.DateTime.Now.Year Premier Automotive Export, Ltd. All Rights Reserved.</div>