{
  "NetMail": {
    "Sender": "contacto@moropo.cu",
    "Host": "moropo.cu",
    "Port": "25",
    "UseSSL": false
  },
  "FileManagement": {
    "MediaDirectoryName": "media",
    "ImagesDirectoryName": "images",
    "VideosDirectoryName": "videos",
    "ThumbnailsDirectoryName": "thumbnails",
    "DocumentsDirectoryName": "documents"
  },
  "ConnectionStrings": {
    "DefaultConnection": "User Id=postgres;Password=p@ssw0rd;Server=localhost;Port=5432;Database=pae-www;Integrated Security=true;Pooling=true;"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": "Error",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/pae-www-.log",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "PEA Web"
    }
  },
  "AllowedHosts": "*"
}
